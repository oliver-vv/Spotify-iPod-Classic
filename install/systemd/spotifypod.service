[Unit]
Description=sPot tkinter UI on X (fbdev)
After=click.service go-librespot.service systemd-user-sessions.service
Wants=click.service go-librespot.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=spotifypod
Group=spotifypod
Environment=HOME=/var/lib/spotifypod
Environment=DISPLAY=:0
EnvironmentFile=-/etc/spotifypod/config.env
WorkingDirectory=/opt/spotifypod/frontend
# Claim VT1 for the framebuffer X server
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
# Runs as root ('+'): rewrite xorg.conf.d to whichever /dev/fbN is the SPI panel
ExecStartPre=+/opt/spotifypod/bin/select-lcd-fb.sh
ExecStart=/usr/bin/xinit /opt/spotifypod/xinitrc -- :0 -nocursor vt1 -nolisten tcp
Restart=on-failure
RestartSec=5
SupplementaryGroups=video audio tty

[Install]
WantedBy=multi-user.target
