[Unit]
Description=sPot setup portal (Wi-Fi / Spotify linking / Bluetooth)
After=network.target bluetooth.service user@__UID__.service
Wants=user@__UID__.service

[Service]
Type=simple
User=spotifypod
Group=spotifypod
Environment=HOME=/var/lib/spotifypod
# pw-dump / wpctl talk to the spotifypod user's PipeWire (user@__UID__.service)
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
EnvironmentFile=-/etc/spotifypod/config.env
WorkingDirectory=/opt/spotifypod/portal
ExecStart=/opt/spotifypod/venv/bin/python -m flask --app app run --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=3
SupplementaryGroups=bluetooth audio
# Binding to port 80: either run as root or use setcap / authbind.
# install.sh grants CAP_NET_BIND_SERVICE on the venv python.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
