[Unit]
Description=iPod click wheel reader (libpigpio, UDP :9090)
After=network.target
# Must NOT run alongside pigpiod: click links libpigpio directly.
Conflicts=pigpiod.service

[Service]
Type=simple
ExecStart=/opt/spotifypod/bin/click
Restart=on-failure
RestartSec=2
# pigpio needs root for GPIO alerts
User=root

[Install]
WantedBy=multi-user.target
