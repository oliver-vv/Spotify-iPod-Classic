# Spotify Web API (PKCE) — create an app at https://developer.spotify.com/dashboard
# Development Mode requires a Premium account on the app owner.
SPOTIPY_CLIENT_ID=your_client_id_here

# HTTPS redirect URI registered on the Spotify app.
# Use the GitHub Pages relay from this repo (docs/spotify-callback.html), e.g.:
#   https://<your-github-user>.github.io/Spotify-iPod-Classic/spotify-callback.html
SPOTIPY_REDIRECT_URI=https://YOUR_USER.github.io/Spotify-iPod-Classic/spotify-callback.html

# Optional: override paths (defaults match install.sh layout)
# SPOTIFYPOD_DATA_DIR=/var/lib/spotifypod
# SPOTIFYPOD_TOKEN_PATH=/var/lib/spotifypod/token.json
# GO_LIBRESPOT_URL=http://127.0.0.1:3678
# PORTAL_HOST=ipod.local

# Blank the display after N seconds without wheel input (0 = never). Default 60.
# SCREEN_TIMEOUT_SECONDS=60
